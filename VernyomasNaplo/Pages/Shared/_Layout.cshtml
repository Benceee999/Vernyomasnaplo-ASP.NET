<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vérnyomás Napló</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-white">
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-page="/Index">Vérnyomás Napló</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index">Napi Teendők (Ápoló)</a>
                        </li>

                        <li class="nav-item ms-sm-auto d-none d-sm-flex align-items-center border-start ps-3 me-2 h-100">
                            <span class="navbar-text small text-muted py-0">Adminisztráció:</span>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Admin/Patients">Páciensek</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Admin/Nurses">Ápolók</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Admin/Stats">Statisztikák</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>