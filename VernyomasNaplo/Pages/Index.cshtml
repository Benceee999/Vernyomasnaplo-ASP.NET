@page
@model IndexModel
@using VernyomasNaplo.Data
@{
    ViewData["Title"] = "Napi Teendők - Ápoló";
}

<div>
    <h3 class="mb-2">Napi mérések áttekintése</h3>
    <p class="text-muted mb-4">A mai napra vonatkozó kötelező (12:00 előtti és utáni) mérések állapota.</p>

    <div class="p-3 bg-light border rounded mb-4">
        <form method="get" class="d-flex align-items-center">
            <label class="me-2 fw-bold text-dark">Szűrés:</label>
            <select asp-for="UserFilter" class="form-select form-select-sm w-auto me-2">
                <option value="all">Minden páciens</option>
                <option value="missing_morning">Reggeli mérés hiányzik</option>
                <option value="missing_evening">Esti mérés hiányzik</option>
                <option value="done_all">Minden mai mérés rögzítve</option>
            </select>
            <button type="submit" class="btn btn-sm btn-primary px-3">Keresés</button>
        </form>
    </div>

    <div class="table-responsive bg-white rounded shadow-sm border">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3 py-3">Páciens Neve (Kartonhoz kattintson rá)</th>
                    <th class="py-3">Szoba</th>
                    <th class="py-3">Reggeli Mérés (0:00 - 12:00)</th>
                    <th class="py-3">Esti Mérés (12:00 - 24:00)</th>
                    <th class="py-3 text-center">Művelet</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Patients != null && Model.Patients.Any())
                {
                    @foreach (var patient in Model.Patients)
                    {
                        var todayMeasurements = patient.Measurements != null
                            ? patient.Measurements.Where(m => m.Date.Date == DateTime.Today).ToList()
                            : new List<Measurement>();

                        var morningMea = todayMeasurements.LastOrDefault(m => m.Date.Hour < 12);
                        var eveningMea = todayMeasurements.LastOrDefault(m => m.Date.Hour >= 12);

                        <tr>
                            <td class="ps-3">
                                <a asp-page="/User/PatientHistory" asp-route-id="@patient.Id" class="text-dark fw-bold text-decoration-none border-bottom" title="Kórtörténet megtekintése">
                                    @patient.Name
                                </a>
                            </td>
                            <td>@patient.RoomNumber</td>

                            <td>
                                @if (morningMea != null)
                                {
                                    var isHigh = morningMea.Systolic > 140 || morningMea.Diastolic > 90 || morningMea.Pulse < 50 || morningMea.Pulse > 100;
                                    <div class="small text-muted mb-1">@morningMea.Date.ToString("HH:mm")</div>
                                    <a asp-page="/User/EditMeasurement" asp-route-id="@morningMea.Id" class="@(isHigh ? "text-danger fw-bold" : "text-primary fw-bold")" style="text-decoration: underline dotted; text-underline-offset: 4px;" title="@(isHigh ? "Figyelem! Magas érték!" : "Adat szerkesztése")">
                                        @morningMea.Systolic / @morningMea.Diastolic (p: @morningMea.Pulse) @(isHigh ? "!" : "")
                                    </a>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold">Hiányzik</span>
                                }
                            </td>

                            <td>
                                @if (eveningMea != null)
                                {
                                    var isHigh = eveningMea.Systolic > 140 || eveningMea.Diastolic > 90 || eveningMea.Pulse < 50 || eveningMea.Pulse >100;
                                    <div class="small text-muted mb-1">@eveningMea.Date.ToString("HH:mm")</div>
                                    <a asp-page="/User/EditMeasurement" asp-route-id="@eveningMea.Id" class="@(isHigh ? "text-danger fw-bold" : "text-primary fw-bold")" style="text-decoration: underline dotted; text-underline-offset: 4px;" title="@(isHigh ? "Figyelem! Magas érték!" : "Adat szerkesztése")">
                                        @eveningMea.Systolic / @eveningMea.Diastolic (p: @eveningMea.Pulse) @(isHigh ? "!" : "")
                                    </a>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold">Hiányzik</span>
                                }
                            </td>

                            <td class="text-center">
                                <a asp-page="/User/NewMeasurement" asp-route-patientId="@patient.Id" class="btn btn-sm btn-outline-primary">Új mérés</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Nincs adat a megadott feltételekkel.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>