@page
@model VernyomasNaplo.Pages.Admin.StatsModel
@{
    ViewData["Title"] = "Statisztikák és XML - Admin";
}

<div>
    <h3 class="mb-4">Statisztikák és Mérési Napló</h3>

    <div class="p-3 bg-white border rounded shadow-sm mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small text-uppercase mb-1">Páciens:</label>
                <select asp-for="SelectedPatientId" class="form-select">
                    <option value="">-- Összes páciens --</option>
                    @foreach (var patient in Model.DropdownPatients)
                    {
                        <option value="@patient.Id">@patient.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small text-uppercase mb-1">Kezdő dátum:</label>
                <input asp-for="StartDate" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small text-uppercase mb-1">Záró dátum:</label>
                <input asp-for="EndDate" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-3 d-flex">
                <button type="submit" class="btn btn-primary px-3 me-2 fw-bold w-50">Frissítés</button>
                <a asp-page-handler="ExportXml"
                   asp-route-SelectedPatientId="@Model.SelectedPatientId"
                   asp-route-StartDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                   asp-route-EndDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                   class="btn btn-success px-3 fw-bold w-50 text-center">XML Letöltés</a>
            </div>
        </form>
    </div>

    <h5 class="mb-3 text-secondary">Összesített adatok (A kiválasztott időszakra)</h5>
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card rounded border shadow-sm h-100">
                <div class="card-header bg-light fw-bold text-dark border-bottom-0 pt-3">Minden mérés</div>
                <div class="card-body">
                    <p class="mb-2 text-muted small">Darabszám: <span class="text-dark fw-bold">@Model.Overall.Count</span></p>
                    @if (Model.Overall.Count > 0)
                    {
                        <p class="mb-1">Átlag: <strong>@Model.Overall.AvgSys.ToString("F1") / @Model.Overall.AvgDia.ToString("F1") (p: @Model.Overall.AvgPulse.ToString("F0"))</strong></p>
                        <p class="mb-1">Min: @Model.Overall.MinSys / @Model.Overall.MinDia (p: @Model.Overall.MinPulse)</p>
                        <p class="mb-0">Max: @Model.Overall.MaxSys / @Model.Overall.MaxDia (p: @Model.Overall.MaxPulse)</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card rounded border shadow-sm h-100">
                <div class="card-header bg-light fw-bold text-dark border-bottom-0 pt-3">Ebből Reggeli mérések</div>
                <div class="card-body">
                    <p class="mb-2 text-muted small">Darabszám: <span class="text-dark fw-bold">@Model.Morning.Count</span></p>
                    @if (Model.Morning.Count > 0)
                    {
                        <p class="mb-1">Átlag: <strong>@Model.Morning.AvgSys.ToString("F1") / @Model.Morning.AvgDia.ToString("F1") (p: @Model.Morning.AvgPulse.ToString("F0"))</strong></p>
                        <p class="mb-1">Min: @Model.Morning.MinSys / @Model.Morning.MinDia (p: @Model.Morning.MinPulse)</p>
                        <p class="mb-0">Max: @Model.Morning.MaxSys / @Model.Morning.MaxDia (p: @Model.Morning.MaxPulse)</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card rounded border shadow-sm h-100">
                <div class="card-header bg-light fw-bold text-dark border-bottom-0 pt-3">Ebből Esti mérések</div>
                <div class="card-body">
                    <p class="mb-2 text-muted small">Darabszám: <span class="text-dark fw-bold">@Model.Evening.Count</span></p>
                    @if (Model.Evening.Count > 0)
                    {
                        <p class="mb-1">Átlag: <strong>@Model.Evening.AvgSys.ToString("F1") / @Model.Evening.AvgDia.ToString("F1") (p: @Model.Evening.AvgPulse.ToString("F0"))</strong></p>
                        <p class="mb-1">Min: @Model.Evening.MinSys / @Model.Evening.MinDia (p: @Model.Evening.MinPulse)</p>
                        <p class="mb-0">Max: @Model.Evening.MaxSys / @Model.Evening.MaxDia (p: @Model.Evening.MaxPulse)</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-8">
            <div class="card rounded border shadow-sm h-100">
                <div class="card-header bg-light fw-bold text-dark border-bottom-0 pt-3">Átlagok összehasonlítása</div>
                <div class="card-body">
                    <canvas id="barChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card rounded border shadow-sm h-100">
                <div class="card-header bg-light fw-bold text-dark border-bottom-0 pt-3">Mérések ezen a héten ápolónként</div>
                <div class="card-body d-flex justify-content-center">
                    <canvas id="pieChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <h5 class="mb-3 text-secondary">Részletes mérési napló</h5>
    <div class="table-responsive bg-white rounded shadow-sm border">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3 py-3">Időpont</th>
                    <th class="py-3">Páciens</th>
                    <th class="py-3">Szoba</th>
                    <th class="py-3">Érték (Sys/Dia)</th>
                    <th class="py-3">Pulzus</th>
                    <th class="py-3">Ápoló</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.FilteredMeasurements != null && Model.FilteredMeasurements.Any())
                {
                    @foreach (var measurement in Model.FilteredMeasurements)
                    {
                        <tr>
                            <td class="ps-3">@measurement.Date.ToString("yyyy. MM. dd. HH:mm")</td>
                            <td class="fw-bold">@measurement.Patient?.Name</td>
                            <td>@measurement.Patient?.RoomNumber</td>
                            <td class="text-primary fw-bold">@measurement.Systolic / @measurement.Diastolic</td>
                            <td class="fw-bold text-dark">@measurement.Pulse</td>
                            <td>@measurement.Nurse?.Name</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Nincs megjeleníthető adat a kiválasztott időszakra.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
        function getChartVal(valStr) {
        return parseFloat(valStr.replace(',', '.')) || 0;
        }

        const barCtx = document.getElementById('barChart').getContext('2d');
        new Chart(barCtx, {
        type: 'bar',
        data: {
        labels: ['Összesített átlag', 'Reggeli átlag', 'Esti átlag'],
        datasets: [
        {
        label: 'Systolé (Sys)',
        backgroundColor: 'rgba(13, 110, 253, 0.7)',
        data: [
        getChartVal('@Model.Overall.AvgSys'),
        getChartVal('@Model.Morning.AvgSys'),
        getChartVal('@Model.Evening.AvgSys')
        ]
        },
        {
        label: 'Diastolé (Dia)',
        backgroundColor: 'rgba(13, 202, 240, 0.7)',
        data: [
        getChartVal('@Model.Overall.AvgDia'),
        getChartVal('@Model.Morning.AvgDia'),
        getChartVal('@Model.Evening.AvgDia')
        ]
        },
        {
        label: 'Pulzus',
        backgroundColor: 'rgba(108, 117, 125, 0.7)',
        data: [
        getChartVal('@Model.Overall.AvgPulse'),
        getChartVal('@Model.Morning.AvgPulse'),
        getChartVal('@Model.Evening.AvgPulse')
        ]
        }
        ]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: { y: { beginAtZero: true } }
        }
        });

        const pieLabels = @Html.Raw(Model.PieChartLabelsJson);
        const pieData = @Html.Raw(Model.PieChartDataJson);
            
        const pieCtx = document.getElementById('pieChart').getContext('2d');
        new Chart(pieCtx, {
        type: 'pie',
        data: {
        labels: pieLabels,
        datasets: [{
        data: pieData,
        backgroundColor: [
        'rgba(13, 110, 253, 0.7)',
        'rgba(25, 135, 84, 0.7)',
        'rgba(255, 193, 7, 0.7)',
        'rgba(220, 53, 69, 0.7)',
        'rgba(13, 202, 240, 0.7)',
        'rgba(102, 16, 242, 0.7)'
        ]
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
        legend: { position: 'bottom' }
        }
        }
        });
        });
    </script>
}